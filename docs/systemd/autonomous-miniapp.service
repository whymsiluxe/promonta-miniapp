[Unit]
Description=Autonomous Codex Promonta miniapp continuation agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=promonta
Group=promonta
WorkingDirectory=/home/promonta/agent/miniapp-repo
Environment=HOME=/home/promonta
Environment=CODEX_HOME=/home/promonta/.codex
Environment=PROMONTA_MINIAPP_REPO=/home/promonta/agent/miniapp-repo
Environment=PROMONTA_AGENT_ROOT=/home/promonta/agent
ExecStart=/home/promonta/agent/miniapp-repo/scripts/autonomous_codex_runner.sh
Nice=5

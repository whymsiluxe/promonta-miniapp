<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Promonta Mini App</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root {
  --primary: #13325C;
  --primary-dark: #0f172a;
  --secondary: #334155;
  --accent: #f59e0b;
  --accent-hover: #d97706;
  --text-main: #334155;
  --text-light: #64748b;
  --bg-light: #f8fafc;
  --bg-white: #ffffff;
  --border-color: #e2e8f0;
  --font-heading: 'Outfit', sans-serif;
  --font-body: 'Montserrat', sans-serif;
  --spacing-xs: 0.5rem;
  --spacing-sm: 1rem;
  --spacing-md: 2rem;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --green: #16a34a;
  --yellow: #f59e0b;
  --red: #dc2626;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-body);
  background: var(--bg-light);
  color: var(--text-main);
  max-width: 480px;
  margin: 0 auto;
  padding-bottom: 7.5rem; /* место под нижнее меню */
}

/* ── Нижнее меню ── */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 480px;
  background: var(--bg-white);
  border-top: 1px solid var(--border-color);
  display: flex;
  padding: 14px 0 max(14px, env(safe-area-inset-bottom));
  z-index: 200;
}

.nav-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 0;
  cursor: pointer;
  color: var(--text-main);
  transition: color 0.15s, transform 0.1s;
}

.nav-item:active { transform: scale(0.9); }
.nav-item.active { color: var(--primary-dark); }
.nav-icon-svg { width: 40px; height: 40px; transition: background-color 0.2s; border-radius: 999px; }
.nav-item.active .nav-icon-svg { stroke-width: 2.3; background: color-mix(in srgb, var(--primary-dark) 12%, transparent); }

.nav-item { position: relative; }
.nav-badge {
  position: absolute;
  top: 6px;
  right: calc(50% - 22px);
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  border-radius: 999px;
  background: #ff3b30;
  color: #fff;
  font-size: 0.62rem;
  font-weight: 700;
  line-height: 16px;
  text-align: center;
  display: none;
}
.nav-badge.show { display: block; }

.view { display: none; }
.view.active { display: block; }

/* ── Общая шапка ── */
header {
  padding: calc(0.75rem + var(--tg-safe-top, env(safe-area-inset-top, 0px)) + 12px) 1rem 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

header h1 {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--primary-dark);
}

.back-arrow {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--bg-white);
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-sm);
  font-size: 1.5rem;
  color: var(--primary-dark);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  flex-shrink: 0;
  transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
}

.back-arrow svg { width: 22px; height: 22px; }
.back-arrow:active { background: var(--bg-light); transform: scale(0.92); box-shadow: var(--shadow-sm); }

.fab {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  border: none;
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
  cursor: pointer;
  flex-shrink: 0;
  transition: transform 0.1s;
}

.fab:active { transform: scale(0.9); }

/* ── Карточки (Объекты + Инструмент) ── */
.cards {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  padding: 0 1rem;
}

.card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-color);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
  -webkit-user-select: none;
  user-select: none;
  -webkit-touch-callout: none;
  touch-action: pan-y;
}

.card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.card.pending { opacity: 0.6; }

.card.dragging {
  opacity: 0.92;
  box-shadow: 0 12px 24px -6px rgba(0,0,0,0.25), 0 4px 8px -2px rgba(0,0,0,0.15);
  z-index: 50;
  transform: scale(1.03);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  animation: card-jiggle 0.25s ease-in-out infinite;
}

@keyframes card-jiggle {
  0%, 100% { rotate: -0.6deg; }
  50% { rotate: 0.6deg; }
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0.75rem;
  gap: 0.75rem;
}

.card-top > div:first-child { min-width: 0; flex: 1; }
.status-group { flex-shrink: 0; }
.tool-card .card-top > div:not(.tool-number-badge):not(.badge) { min-width: 0; flex: 1; }

.card-title {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--primary-dark);
}

.card-address, .card-meta {
  font-size: 0.85rem;
  color: var(--text-light);
  margin-top: 2px;
}

.tool-number-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 26px;
  height: 18px;
  padding: 0 0.35rem;
  margin-left: 0.3rem;
  border-radius: 999px;
  background: var(--bg-light);
  border: 1px solid var(--border-color);
  color: var(--text-light);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.65rem;
  vertical-align: middle;
}

.tool-title-clamp {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tool-card .card-body { padding-top: 0.5rem; margin-top: 0.5rem; }
.tool-card .take-btn { margin-top: 0.6rem; padding: 0.45rem; font-size: 0.8rem; }

.badge {
  font-size: 0.7rem;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  white-space: nowrap;
  flex-shrink: 0;
}

.badge.active, .badge.free { background: #dcfce7; color: #15803d; }
.badge.paused, .badge.in-use { background: #fef3c7; color: #92400e; }
.badge.done { background: #dbeafe; color: #1d4ed8; }
.badge.repair { background: #fee2e2; color: #b91c1c; }
.badge.missing { background: #e2e8f0; color: #475569; }

.card-stage {
  font-size: 0.8rem;
  color: var(--text-light);
  margin-bottom: 0.9rem;
  display: flex;
  justify-content: space-between;
  gap: 0.5rem;
}
.card-stage b { color: var(--text-main); font-weight: 600; }
.card-stage .stage-wait { display: flex; flex-direction: column; gap: 1px; }

.status-group {
  display: flex;
  flex-direction: column-reverse;
  align-items: flex-end;
  gap: 6px;
}

.segments { display: flex; align-items: center; gap: 4px; height: 8px; user-select: none; }

.segment {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--border-color);
  cursor: pointer;
  transition: background 0.1s;
}

.segment.filled { background: #0d9488; }

.status-switch {
  display: flex;
  background: var(--bg-light);
  border-radius: var(--radius-md);
  padding: 3px;
  margin-bottom: 0.75rem;
  gap: 2px;
}

.status-switch .status-opt {
  flex: 1;
  text-align: center;
  padding: 5px 4px;
  border-radius: 6px;
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--text-light);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  user-select: none;
}

.status-switch .status-opt.active[data-status="В работе"] { background: #dcfce7; color: #15803d; }
.status-switch .status-opt.active[data-status="Пауза"] { background: #fef3c7; color: #92400e; }
.status-switch .status-opt.active[data-status="Завершён"] { background: #dbeafe; color: #1d4ed8; }
.status-switch.readonly .status-opt { cursor: default; }

.tasks-label {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-light);
  margin-bottom: 0.5rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 5px;
}

.tasks-label .chevron, .history-label .chevron {
  font-size: 0.65rem;
  transition: transform 0.2s;
  display: inline-block;
}

.tasks-label.collapsed .chevron, .history-label.collapsed .chevron { transform: rotate(-90deg); }

.tasks-count { font-weight: 400; color: var(--text-light); font-size: 0.75rem; }

.tasks-body, .history-body {
  overflow: hidden;
  max-height: 500px;
  transition: max-height 0.25s ease;
}

.tasks-body.collapsed, .history-body.collapsed { max-height: 0; }

.metrics {
  display: flex;
  gap: 1.25rem;
  border-top: 1px solid var(--border-color);
  margin-top: 0.9rem;
  padding-top: 0.75rem;
}

.metric { flex: 1; }

.metric-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.95rem;
  color: var(--text-light);
  margin-bottom: 4px;
}

.metric-row b { color: var(--text-main); font-weight: 600; font-size: 0.8rem; }

.metric-bar { height: 10px; border-radius: 999px; background: var(--border-color); overflow: hidden; }

.metric-fill { height: 100%; border-radius: 999px; transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
.metric-fill.green { background: linear-gradient(90deg, #22c55e, var(--green)); }
.metric-fill.yellow { background: linear-gradient(90deg, #fbbf24, var(--yellow)); }
.metric-fill.red { background: linear-gradient(90deg, #ef4444, var(--red)); }
.metric-fill.blue { background: linear-gradient(90deg, #93c5fd, #60a5fa); }

.task-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.35rem 0; font-size: 0.9rem; }

.checkbox {
  width: 18px;
  height: 18px;
  border-radius: 5px;
  border: 2px solid var(--border-color);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s, transform 0.1s;
}

.checkbox:hover { border-color: var(--primary); transform: scale(1.08); }

.checkbox.done { background: var(--primary); border-color: var(--primary); color: white; font-size: 0.65rem; }
.checkbox.disabled { cursor: default; opacity: 0.6; }
.checkbox.disabled:hover { transform: none; border-color: var(--border-color); }

.task-row span { transition: color 0.15s; }
.task-row.done span { text-decoration: line-through; color: var(--text-light); }

.add-task {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.5rem 0 0.2rem;
  font-size: 0.9rem;
  color: var(--accent-hover);
  font-weight: 500;
  cursor: pointer;
}

/* ── Инструмент: поиск/фильтры/история ── */
.search-bar { padding: 0 1rem 0.75rem; }

.search-bar input {
  width: 100%;
  padding: 0.65rem 0.9rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.9rem;
  background: var(--bg-white);
  color: var(--text-main);
}

.search-bar input::placeholder { color: var(--text-light); }

.filters { display: flex; gap: 0.5rem; padding: 0 1rem 0.9rem; overflow-x: auto; }

.filter-chip {
  flex-shrink: 0;
  padding: 5px 14px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 600;
  background: var(--bg-white);
  border: 1px solid var(--border-color);
  color: var(--text-light);
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}

.filter-chip.active { background: var(--primary); border-color: var(--primary); color: white; }

.card-body {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.info-row { display: flex; justify-content: space-between; font-size: 0.85rem; }
.info-row span:first-child { color: var(--text-light); }
.info-row span:last-child { color: var(--text-main); font-weight: 500; text-align: right; }

.history-label {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-light);
  margin-top: 0.6rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 5px;
}

.history-row {
  display: flex;
  gap: 0.6rem;
  font-size: 0.8rem;
  padding: 0.3rem 0;
  border-left: 2px solid var(--border-color);
  padding-left: 0.6rem;
  margin-left: 3px;
}

.history-row .h-date { color: var(--text-light); white-space: nowrap; }
.history-row .h-text { color: var(--text-main); }
.history-empty { font-size: 0.8rem; color: var(--text-light); padding: 0.3rem 0; }

.empty-state { padding: 2rem 1rem; text-align: center; color: var(--text-light); font-size: 0.9rem; }

.take-btn {
  width: 100%;
  margin-top: 0.75rem;
  padding: 0.55rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--primary);
  background: var(--bg-white);
  color: var(--primary);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}

.take-btn:active { background: var(--primary); color: white; }

/* ── Модалки (Инструмент) ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 100%;
  max-width: 480px;
  max-height: 85vh;
  overflow-y: auto;
  background: var(--bg-white);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.modal-input, .modal-select { scroll-margin-top: 1rem; scroll-margin-bottom: 8rem; }

.modal-title {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--primary-dark);
  margin-bottom: 0.5rem;
}

.modal-label { font-size: 0.8rem; color: var(--text-light); font-weight: 600; margin-top: 0.4rem; }

.modal-select, .modal-input {
  width: 100%;
  padding: 0.6rem 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.9rem;
  background: var(--bg-white);
  color: var(--text-main);
}

.modal-actions {
  display: flex;
  gap: 0.6rem;
  margin-top: 1rem;
  position: sticky;
  bottom: 0;
  background: var(--bg-white);
  padding-top: 0.75rem;
  padding-bottom: env(safe-area-inset-bottom, 0);
}

.modal-btn {
  flex: 1;
  padding: 0.65rem;
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  border: none;
}

.modal-btn.secondary { background: var(--bg-light); color: var(--text-main); }
.modal-btn.primary { background: var(--primary); color: white; }

/* ── Полноэкранная форма (Новый объект) ── */
#new-object-view { display: none; padding-bottom: 6rem; }
#new-object-view.open { display: block; }

#stages-view { display: none; padding-bottom: 2rem; }
#stages-view.open { display: block; }

.stage-clickable { cursor: pointer; align-items: center; }
.stage-edit-icon { font-size: 0.75rem; margin-left: 4px; opacity: 0.6; }

.stage-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.7rem 0;
  border-bottom: 1px solid var(--border-color);
}

.stage-row-name { flex: 1; font-size: 0.9rem; color: var(--text-main); }

.stage-row-status {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
  cursor: pointer;
  white-space: nowrap;
}

.stage-status-предстоит { background: var(--bg-light); color: var(--text-light); }
.stage-status-в-процессе { background: #fef3c7; color: #92400e; }
.stage-status-готово { background: #dcfce7; color: #15803d; }

.stage-row-delete {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: none;
  background: var(--bg-light);
  color: var(--red);
  font-size: 0.9rem;
  cursor: pointer;
  flex-shrink: 0;
}

.form-header { display: flex; align-items: center; gap: 0.75rem; padding: 1.25rem 1rem 1rem; }

.form-header .back-btn {
  background: none;
  border: none;
  font-size: 1.3rem;
  color: var(--primary);
  cursor: pointer;
  padding: 0;
  line-height: 1;
}

.form-header h1 {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--primary-dark);
}

.form-section { padding: 0 1rem; display: flex; flex-direction: column; gap: 0.9rem; }

.form-field label {
  display: block;
  font-size: 0.8rem;
  color: var(--text-light);
  font-weight: 600;
  margin-bottom: 4px;
}

.form-field input {
  width: 100%;
  padding: 0.65rem 0.8rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.9rem;
  background: var(--bg-white);
  color: var(--text-main);
}

.form-row { display: flex; gap: 0.6rem; }
.form-row .form-field { flex: 1; }

.form-submit-bar {
  position: fixed;
  bottom: 7.5rem; /* над нижним меню */
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 480px;
  background: var(--bg-white);
  border-top: 1px solid var(--border-color);
  padding: 0.9rem 1rem;
  box-shadow: 0 -2px 8px rgba(0,0,0,0.06);
}

.form-submit-btn {
  width: 100%;
  padding: 0.8rem;
  border-radius: var(--radius-md);
  border: none;
  background: var(--primary);
  color: white;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
}

.form-submit-btn:disabled { opacity: 0.5; cursor: default; }

.form-error {
  margin: 0 1rem;
  padding: 0.7rem 1rem;
  background: #fee2e2;
  color: #b91c1c;
  border-radius: var(--radius-md);
  font-size: 0.85rem;
}

/* ── Angebot ── */
.doc-type-switch {
  display: flex;
  background: var(--bg-light);
  border-radius: var(--radius-md);
  padding: 3px;
  margin: 0 1rem 1rem;
  gap: 2px;
}

.doc-type-opt {
  flex: 1;
  text-align: center;
  padding: 8px 4px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-light);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}

.doc-type-opt.active { background: var(--primary); color: white; }

.feed-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  padding: 0 0.75rem;
}
.feed-photo-item { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: var(--bg-light); }
.feed-photo-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
.feed-photo-item .feed-photo-meta {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.65));
  color: #fff; font-size: 0.6rem; padding: 12px 6px 4px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.section {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 1.1rem 1.25rem;
  margin: 0 1rem 1rem;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-color);
}

.section-title {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--primary-dark);
  margin-bottom: 0.8rem;
}

.field { margin-bottom: 0.7rem; }

<script>
const loadedViews = new Set();

function switchView(viewName) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById(`view-${viewName}`).classList.add('active');
  document.querySelector(`.nav-item[data-view="${viewName}"]`).classList.add('active');

  const nav = document.querySelector('.bottom-nav');
  if (nav) nav.style.display = (viewName === 'chat') ? 'none' : 'flex';

  if (!loadedViews.has(viewName)) {
    loadedViews.add(viewName);
    if (viewName === 'objects') initObjectsView();
    if (viewName === 'feed') initFeedView();
    if (viewName === 'chat') initChatView();
  } else if (viewName === 'chat') {
    _loadChatMessages(true);
  }

  if (viewName === 'chat') markChatRead();
}

document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', () => switchView(item.dataset.view));
});

// Стрелка на корневых вкладках (Лента/Объекты) закрывает Mini App —
// это top-level экраны, "назад" в истории браузера для них не имеет смысла.
function closeMiniApp() {
  hapticImpact('light');
  const wa = window.Telegram?.WebApp;
  if (wa?.close) { wa.close(); return; }
  history.back();
}

function _applyTelegramSafeArea() {
  const wa = window.Telegram?.WebApp;
  if (!wa) return;
  const csa = wa.contentSafeAreaInset || {};
  const sa = wa.safeAreaInset || {};
  const top = Math.max(csa.top || 0, sa.top || 0);
  document.documentElement.style.setProperty('--tg-safe-top', top + 'px');
}

async function initApp() {
  window.Telegram?.WebApp?.expand();
  try { window.Telegram?.WebApp?.requestFullscreen?.(); } catch (e) {}
  try { window.Telegram?.WebApp?.disableVerticalSwipes?.(); } catch (e) {}

  _applyTelegramSafeArea();
  setTimeout(_applyTelegramSafeArea, 300);
  try {
    window.Telegram?.WebApp?.onEvent?.('safeAreaChanged', _applyTelegramSafeArea);
    window.Telegram?.WebApp?.onEvent?.('contentSafeAreaChanged', _applyTelegramSafeArea);
    window.Telegram?.WebApp?.onEvent?.('fullscreenChanged', _applyTelegramSafeArea);
  } catch (e) {}

  startUnreadChatPolling();

  if (!initData) {
    document.body.innerHTML = '<div style="padding:2rem 1rem;text-align:center;color:var(--text-light)">Открыто вне Telegram — нет initData для авторизации API.</div>';
    return;
  }

  try {
    await fetchRole();
  } catch (e) {
    document.body.innerHTML = `<div style="padding:2rem 1rem;text-align:center;color:var(--red)">Ошибка авторизации: ${e.message}</div>`;
    return;
  }

  switchView('feed');
}

initApp();
</script>


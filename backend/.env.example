# Telegram bot token (@BotFather) — used for initData validation (HMAC) and sendMessage/sendDocument API calls.
# Required — main.py fails at import (os.environ['BOT_TOKEN']) if this is missing.
BOT_TOKEN=

# Path to Claude Code CLI binary, invoked as a subprocess for AI chat / task-extraction features.
CLAUDE_BIN=

# GLM API key (Zhipu), fallback/alternative model for AI chat features. Optional.
GLM_KEY=

# --- Grandmont Group rebrand (26.09): all optional, commented out = current behaviour. ---
# main.py still reads the pre-rebrand PROMONTA_* name of each var below as a fallback.
#
# Contact email printed on Angebot PDFs (backend/angebot_free.js).
# LEGACY_CONTACT_DOMAIN / DOMAIN_COMPAT_PENDING: unset -> falls back to the current
# address on the pre-rebrand promonta-bau.de domain. Set it only once a real Grandmont
# Group mailbox exists -- do not invent one.
# GRANDMONT_GROUP_CONTACT_EMAIL=
#
# Logo for Rechnung PDFs (backend/rechnung.js). Unset -> backend/grandmont-group-logo.png,
# or a text wordmark if that file is missing.
# GRANDMONT_GROUP_LOGO_PATH=
#
# Set to "test" by the test suite only (arms the prod-DATA_ROOT guard). Legacy: PROMONTA_ENV.
# GRANDMONT_GROUP_ENV=
#
# Path overrides. Legacy: PROMONTA_AGENT_ROOT / PROMONTA_CREATE_OBJECT_SCRIPT /
# PROMONTA_CREATE_OBJECT_FOLDER_SCRIPT.
# GRANDMONT_GROUP_AGENT_ROOT=
# GRANDMONT_GROUP_CREATE_OBJECT_SCRIPT=
# GRANDMONT_GROUP_CREATE_OBJECT_FOLDER_SCRIPT=

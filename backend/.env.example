# Telegram bot token (@BotFather) — used for initData validation (HMAC) and sendMessage/sendDocument API calls
BOT_TOKEN=

# Path to Claude Code binary, used by AI-assistant features
CLAUDE_BIN=

# GLM API key (Zhipu), alternative/fallback model for AI chat features
GLM_KEY=

# Comma-separated list or single chat id — restricts which Telegram chat can trigger certain flows
ALLOWED_CHAT=

# Shared secret for the lead-intake webhook endpoint (separate service, promonta-webhook)
WEBHOOK_SECRET=
